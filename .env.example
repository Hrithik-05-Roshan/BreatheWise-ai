# BreatheWise AI Environment Configuration

# Optional: Google Gemini API Key for dynamic AI Assistant
# If omitted, BreatheWise operates automatically in deterministic intelligence mode with complete feature coverage
GEMINI_API_KEY=

# Optional: External Open-Meteo Air Quality Base URL (Defaults to standard public endpoint)
NEXT_PUBLIC_AQI_API_BASE=https://air-quality-api.open-meteo.com/v1/air-quality

# Application Environment
NODE_ENV=development
